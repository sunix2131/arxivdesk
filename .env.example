# arXiv API sync configuration
ARXIV_DAYS_TO_KEEP=90
ARXIV_PAGE_SIZE=100
ARXIV_MAX_RESULTS=5000
ARXIV_REQUEST_DELAY_MS=3000
ARXIV_MAX_RETRIES=4
ARXIV_RETRY_BASE_MS=15000

# Use RSS feed instead of API (avoids rate limiting but gets fewer papers)
# ARXIV_RSS_ONLY=1

# Filter to specific categories (comma-separated slugs)
# ARXIV_CATEGORY_SLUGS=cs.AI,cs.CL

# Direct API queries (comma-separated, overrides category filtering)
# ARXIV_QUERIES=cat:cs.AI,cat:stat.ML

# Browser search endpoint. Local development uses the Vite /arxiv-api proxy.
# Set this when the deployed application exposes the proxy at another path.
# VITE_ARXIV_API_URL=/api/arxiv

# Translation configuration
TRANSLATE_LIMIT=50
TRANSLATE_DELAY_MS=700
# TRANSLATE_FORCE=1
