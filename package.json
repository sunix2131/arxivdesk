{
  "name": "arxivdesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "sync": "node --env-file-if-exists=.env scripts/sync-arxiv.mjs",
    "translate:ru": "node --env-file-if-exists=.env scripts/translate-papers-ru.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@vitalets/google-translate-api": "^9.2.1",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.40.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
